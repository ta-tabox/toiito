{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/check-database-drift.ts && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check && node scripts/lint-comments.ts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed/index.ts",
    "db:prune": "node scripts/prune-test-databases.ts",
    "migrate:prod": "node --env-file-if-exists=.env.local scripts/migrate.ts prod",
    "migrate:preview": "node --env-file-if-exists=.env.local scripts/migrate.ts preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "tsc --noEmit && pnpm lint && vitest run && next build",
    "check:full": "pnpm check && pnpm e2e",
    "format": "biome format --write"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/typescript6": "^6.0.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.11"
  }
}
