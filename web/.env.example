# Claude API（サーバー側のみ。クライアントに露出させない）
ANTHROPIC_API_KEY=

# 任意: モデル上書き（既定 claude-sonnet-5）
# TOIITO_ANTHROPIC_MODEL=

# 任意。一回の応答に許すトークン数（既定 16000。thinking の分もここから引かれるので、下げすぎると本文が途中で切れる）
# TOIITO_ANTHROPIC_MAX_TOKENS=

# 任意。一回の呼び出しを待つ上限のミリ秒（既定 120000。超えたら例外になる。実行環境が関数を殺す 300 秒より手前に置く）
# TOIITO_ANTHROPIC_TIMEOUT_MS=

# 任意。具体さんの思考の深さ（既定は未設定で API の既定に任せる。low / medium / high / xhigh / max。値域の外は既定へ倒す）
# TOIITO_ANTHROPIC_EFFORT_CONCRETE=

# 任意。抽象さんの思考の深さ（既定 medium。値域は同上）
# TOIITO_ANTHROPIC_EFFORT_ABSTRACT=

# 本番では必須。Basic 認証の利用者名（development では未設定なら認証を掛けない）
# TOIITO_BASIC_AUTH_USER=
# 同じ Basic 認証のパスワード（片方だけ設定すると起動時に落ちる）
# TOIITO_BASIC_AUTH_PASSWORD=

# 任意。1 でネットワークに出ず決定的な応答を返す（API キー無しで縦一本を通すためのハーネス）
# TOIITO_FAKE_AI=

# 任意。テストの接続先（既定 postgresql://toiito:toiito@localhost:5433/toiito_test。CI で差し替える口）
# TOIITO_TEST_DATABASE_URL=

# 任意。E2E の接続先（既定 postgresql://toiito:toiito@localhost:5433/toiito_e2e。テストと同じ DB を向けない）
# TOIITO_E2E_DATABASE_URL=

# アプリからの接続先（本番 Neon ではプーラー経由）
DATABASE_URL=
# Prisma Migrate 用の直結（プーラー越しには Migrate が動かないので分ける）
DIRECT_URL=

# 任意。手元から本番へ migration を流すときの直結（pnpm migrate:prod）
# DIRECT_URL_PROD=
# 任意。同じく Neon の preview ブランチへ流すときの直結（pnpm migrate:preview）
# DIRECT_URL_PREVIEW=
