/**
 * 永続化スキーマの正。意味（なぜこの形か）の正は ARCHITECTURE.md「データモデル」。
 *
 * ファイル全体に効く約束は二つだけで、残りは各宣言のコメントが持つ。
 *
 * フィールド名は snake_case。
 * 列名・ドメイン型（src/lib/types.ts）と三者の名前が揃い、repo 層の詰め替えが要らなくなる。
 * 例外は Better Auth の四表（User / Session / Account / Verification）で、生成された綴りのまま置く。
 * 揃えると版が上がるたびに手で直すことになり、そこまでして揃える利益がこの四表には無い（docs/adr/0019-auth-better-auth.md）。
 *
 * check 制約は Prisma スキーマで表現できないため migration の SQL が唯一の置き場になる。
 * どのモデルに何が効いているかは各モデルのコメントに書く。
 */

/// 生成物の相対 import に拡張子を綴らせる。
/// バンドラ（Next / vitest）は拡張子が無くても解けるが、素の ESM 解決には要る。
///
/// output は絶対パスにできない。
/// 環境ごとに違う値を書くことになり、他のマシンと CI で壊れる（この位置はスキーマからの相対で解決される）。
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

/// 接続先は prisma.config.ts が持つ（Prisma 7 でスキーマから移った）。
datasource db {
  provider = "postgresql"
}

/// 問いの状態。7 値である理由と各値の意味は ARCHITECTURE.md「問いの状態機械」。
///
/// 値は比喩を持たない一般語で持ち、比喩は UI のラベルだけが持つ（`docs/adr/0017-status-value-set.md`）。
/// 比喩は選び直しうるが enum の変更は本番の DB を動かすので、値の側へ比喩を持ち込まない。
///
/// TS 側の対応は `src/lib/question.ts` の `QUESTION_STATUSES`（型 `QuestionStatus` と UI ラベルがそこから派生する）。
/// 二箇所に書くのは冗長に見えるが、ずれると repo 関数の戻り値がドメイン型へ代入できなくなり `tsc` が落ちる。
/// ここに値を足したら向こうにも足す。
enum QuestionStatus {
  new
  stocked
  resolved
  exported
  holding
  permanent
  discarded

  @@map("question_status")
}

/// 発話者。人間と AI 二体。
/// TS 側の対応は `src/lib/types.ts` の `Speaker`。ずれの検出は QuestionStatus と同じ。
enum Speaker {
  human
  ai_a
  ai_b

  @@map("speaker")
}

/// 問い。コンポスターへの投入単位。
/// body は原型（投入された生の問い。転記誤りの訂正以外では書き換えない）、
/// current_form は対話の中で言い直された焦点。
///
/// `user_id` を持つのは所有のルートだけで、いまはこのモデル一つ（`docs/adr/0020-ownership-granularity.md`）。
/// 型が UUID でなく String なのは、Better Auth の `user.id` に合わせるため。
model Question {
  id           String         @id @default(uuid(4)) @db.Uuid
  user_id      String
  body         String
  current_form String?
  status       QuestionStatus @default(new)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  /// 挿入順の通し番号。同着を割るための列（意図は Message.seq）。
  seq          BigInt         @default(autoincrement()) @unique

  user     User              @relation(fields: [user_id], references: [id])
  sessions DialogueSession[]

  @@index([user_id])
  @@map("questions")
}

/// 対話セッション。一つの問いが複数持つ（`question_id` は同じまま増える）。
///
/// 最初の一つは問いの投入時に作られる。
/// 二つ目以降は、同じ問いを対話画面から「新しいセッションで再訪」したときに増える（`createSession`）。
/// 問いに何度戻ったかが読み返せるように、過去のセッションは畳まれず、堆積したまま残る。
///
/// モデル名だけが `Dialogue` を冠する。
/// Better Auth のログインセッションが `Session` を名乗り、Prisma のモデル名は一意でなければならないため（`docs/adr/0027-ownership-before-auth.md`）。
/// 表・列・ドメイン型（`types.ts` の `Session`）はどれも動いていない。
model DialogueSession {
  id          String   @id @default(uuid(4)) @db.Uuid
  question_id String   @db.Uuid
  started_at  DateTime @default(now()) @db.Timestamptz(6)
  /// 挿入順の通し番号。同着を割るための列（意図は Message.seq）。
  seq         BigInt   @default(autoincrement()) @unique

  question Question  @relation(fields: [question_id], references: [id])
  messages Message[]

  @@index([question_id])
  @@map("sessions")
}

/// 発話。人間 + AI 二体の三者。
/// 追記のみで編集しない（immutable）。メモのアンカーが腐らないための不変条件。
model Message {
  id         String   @id @default(uuid(4)) @db.Uuid
  session_id String   @db.Uuid
  speaker    Speaker
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  /// 挿入順の通し番号。発話の並びを実装依存にしないための列。
  /// created_at は同一マイクロ秒で並びうるし、id は乱数の UUIDv4 で順序を持たない。
  /// 二つだけでは全順序にならず、ai_a と ai_b が入れ替わりうる（ai_b は ai_a への応答なので、並びは意味そのもの）。
  /// 並べ替え専用の列で、表示にも意味の判断にも使わないので、ドメイン型には出さない（db.ts が omit する）。
  seq        BigInt   @default(autoincrement()) @unique

  session DialogueSession @relation(fields: [session_id], references: [id])
  memos   Memo[]

  @@index([session_id])
  @@map("messages")
}

/// キーワードメモ。メッセージ本文の一部（anchor_start〜anchor_end）に付く。
///
/// **DB 側に check 制約が効いている**（`memos_anchor_range_check`）:
/// `anchor_start >= 0 and anchor_end > anchor_start`。
/// Prisma スキーマでは表現できないので実体は migration の SQL にある。
/// このモデルの列を動かすときは、そちらも一緒に見ること。
///
/// `anchor_end <= 本文長` はここでは表明できない（DB は本文長を知らない）。
/// 本文を読める db.ts の addMemo が守る。
model Memo {
  id           String   @id @default(uuid(4)) @db.Uuid
  message_id   String   @db.Uuid
  anchor_start Int
  anchor_end   Int
  keyword      String
  note         String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  /// 挿入順の通し番号。同着を割るための列（意図は Message.seq）。
  seq          BigInt   @default(autoincrement()) @unique

  message    Message    @relation(fields: [message_id], references: [id])
  links_from MemoLink[] @relation("MemoLinkFrom")
  links_to   MemoLink[] @relation("MemoLinkTo")

  @@index([message_id])
  @@index([keyword])
  @@map("memos")
}

/// メモ間のリンキング辺。MVP では書き込まない（テーブルだけ切っておく）。
/// 実装粒度（kind をキーワード一致にするか埋め込みにするか）は ARCHITECTURE.md の開いた問い。
model MemoLink {
  id           String   @id @default(uuid(4)) @db.Uuid
  from_memo_id String   @db.Uuid
  to_memo_id   String   @db.Uuid
  kind         String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  from_memo Memo @relation("MemoLinkFrom", fields: [from_memo_id], references: [id])
  to_memo   Memo @relation("MemoLinkTo", fields: [to_memo_id], references: [id])

  @@map("memo_links")
}

/// 利用者。Better Auth が持つ四表の一つ。
///
/// 綴りは Better Auth 1.7.2 が要求するまま（camelCase・型は既定）で、snake_case へ揃えない（`docs/adr/0019-auth-better-auth.md`）。
/// 揃えると版が上がるたびに手で直すことになる。
/// この四表を読むのは `db.ts` の二つの用途だけで、詰め替えが増えないことが据え置きの条件（`docs/adr/0027-ownership-before-auth.md`）。
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  questions Question[]

  @@map("user")
}

/// ログインのセッション。Better Auth が持つ四表の一つ。
///
/// **対話の `sessions` とは別物**。
/// こちらはログイン、あちらは問いへの再訪（`DialogueSession`）。
/// 綴りの規約は User と同じ。
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// 外部 IdP のアカウント。Better Auth が持つ四表の一つ。
///
/// プロバイダと IdP 側の識別子を持つのは `user` でなくこちら（`docs/adr/0019-auth-better-auth.md`）。
/// OAuth のトークンは保存しない方針だが、列は Better Auth の要求どおり置く（保存しないのは実行時の設定で、#68 が入れる）。
/// 綴りの規約は User と同じ。
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

/// 検証トークン。Better Auth が持つ四表の一つ。
///
/// パスワードを実装しないのでこの器では使わないが、Better Auth が四表を前提に動くので置く。
/// 綴りの規約は User と同じ。
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
