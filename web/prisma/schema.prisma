/**
 * 永続化スキーマの正。意味（なぜこの形か）の正は ARCHITECTURE.md「データモデル」。
 *
 * ファイル全体に効く約束は二つだけで、残りは各宣言のコメントが持つ。
 *
 * フィールド名は snake_case。
 * 列名・ドメイン型（src/lib/types.ts）と三者の綴りが揃い、repo 層の詰め替えが要らなくなる。
 *
 * check 制約は Prisma スキーマで表現できないため migration の SQL が唯一の置き場になる。
 * どのモデルに何が効いているかは各モデルのコメントに書く。
 */

/// 生成物の相対 import に拡張子を綴らせる。
/// バンドラ（Next / vitest）は拡張子が無くても解けるが、素の ESM 解決には要る。
///
/// output は絶対パスにできない。
/// 環境ごとに違う値を書くことになり、他のマシンと CI で壊れる（この位置はスキーマからの相対で解決される）。
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

/// 接続先は prisma.config.ts が持つ（Prisma 7 でスキーマから移った）。
datasource db {
  provider = "postgresql"
}

/// 問いの状態。6 値である理由と各値の意味は ARCHITECTURE.md「問いの状態機械」。
///
/// TS 側の対応は `src/lib/question.ts` の `QUESTION_STATUSES`（型 `QuestionStatus` と UI ラベルがそこから派生する）。
/// 二箇所に書くのは冗長に見えるが、ずれると repo 関数の戻り値がドメイン型へ代入できなくなり `tsc` が落ちる。
/// ここに値を足したら向こうにも足す。
enum QuestionStatus {
  composting
  fermented
  promoted
  open
  perennial
  discarded

  @@map("question_status")
}

/// 発話者。人間と AI 二体。
/// TS 側の対応は `src/lib/types.ts` の `Speaker`。ずれの検出は QuestionStatus と同じ。
enum Speaker {
  human
  ai_a
  ai_b

  @@map("speaker")
}

/// 問い。コンポスターへの投入単位。
/// body は原型（投入された生の問い。転記誤りの訂正以外では書き換えない）、
/// current_form は対話の中で言い直された焦点。
model Question {
  id           String         @id @default(uuid(4)) @db.Uuid
  body         String
  current_form String?
  status       QuestionStatus @default(composting)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  /// 挿入順の通し番号。同着を割るための列（意図は Message.seq）。
  seq          BigInt         @default(autoincrement()) @unique

  sessions Session[]

  @@map("questions")
}

/// 対話セッション。一つの問いが複数持つ（`question_id` は同じまま増える）。
///
/// 最初の一つは問いの投入時に作られる。
/// 二つ目以降は、同じ問いを対話画面から「新しいセッションで再訪」したときに増える（`createSession`）。
/// 問いに何度戻ったかが読み返せるように、過去のセッションは畳まれず、堆積したまま残る。
model Session {
  id          String   @id @default(uuid(4)) @db.Uuid
  question_id String   @db.Uuid
  started_at  DateTime @default(now()) @db.Timestamptz(6)
  /// 挿入順の通し番号。同着を割るための列（意図は Message.seq）。
  seq         BigInt   @default(autoincrement()) @unique

  question Question  @relation(fields: [question_id], references: [id])
  messages Message[]

  @@index([question_id])
  @@map("sessions")
}

/// 発話。人間 + AI 二体の三者。
/// 追記のみで編集しない（immutable）。メモのアンカーが腐らないための不変条件。
model Message {
  id         String   @id @default(uuid(4)) @db.Uuid
  session_id String   @db.Uuid
  speaker    Speaker
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  /// 挿入順の通し番号。発話の並びを実装依存にしないための列。
  /// created_at は同一マイクロ秒で並びうるし、id は乱数の UUIDv4 で順序を持たない。
  /// 二つだけでは全順序にならず、ai_a と ai_b が入れ替わりうる（ai_b は ai_a への応答なので、並びは意味そのもの）。
  /// 並べ替え専用の列で、表示にも意味の判断にも使わないので、ドメイン型には出さない（db.ts が omit する）。
  seq        BigInt   @default(autoincrement()) @unique

  session Session @relation(fields: [session_id], references: [id])
  memos   Memo[]

  @@index([session_id])
  @@map("messages")
}

/// キーワードメモ。メッセージ本文の一部（anchor_start〜anchor_end）に付く。
///
/// **DB 側に check 制約が効いている**（`memos_anchor_range_check`）:
/// `anchor_start >= 0 and anchor_end > anchor_start`。
/// Prisma スキーマでは表現できないので実体は migration の SQL にある。
/// このモデルの列を動かすときは、そちらも一緒に見ること。
///
/// `anchor_end <= 本文長` はここでは表明できない（DB は本文長を知らない）。
/// 本文を読める db.ts の addMemo が守る。
model Memo {
  id           String   @id @default(uuid(4)) @db.Uuid
  message_id   String   @db.Uuid
  anchor_start Int
  anchor_end   Int
  keyword      String
  note         String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  /// 挿入順の通し番号。同着を割るための列（意図は Message.seq）。
  seq          BigInt   @default(autoincrement()) @unique

  message   Message    @relation(fields: [message_id], references: [id])
  links_from MemoLink[] @relation("MemoLinkFrom")
  links_to   MemoLink[] @relation("MemoLinkTo")

  @@index([message_id])
  @@index([keyword])
  @@map("memos")
}

/// メモ間のリンキング辺。MVP では書き込まない（テーブルだけ切っておく）。
/// 実装粒度（kind をキーワード一致にするか埋め込みにするか）は ARCHITECTURE.md の開いた問い。
model MemoLink {
  id           String   @id @default(uuid(4)) @db.Uuid
  from_memo_id String   @db.Uuid
  to_memo_id   String   @db.Uuid
  kind         String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  from_memo Memo @relation("MemoLinkFrom", fields: [from_memo_id], references: [id])
  to_memo   Memo @relation("MemoLinkTo", fields: [to_memo_id], references: [id])

  @@map("memo_links")
}
