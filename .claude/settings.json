{
  "attribution": {
    "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(pnpm check)",
      "Bash(pnpm run check)",
      "Bash(pnpm lint)",
      "Bash(pnpm run lint)",
      "Bash(pnpm format)",
      "Bash(pnpm run format)",
      "Bash(pnpm run build)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec biome check:*)",
      "Bash(pnpm exec biome format:*)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(pnpm exec next build:*)",
      "Bash(pnpm install)",
      "Bash(mise ls:*)",
      "Bash(mise current:*)",
      "Bash(mise where:*)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-force-push.sh",
            "if": "Bash(git:*)",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "リモート環境を準備中"
          }
        ]
      }
    ]
  }
}
