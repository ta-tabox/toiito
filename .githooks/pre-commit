#!/bin/bash
#
# ステージした追加行に禁止語があれば、scripts/lint-vocabulary.sh の報告を表示する。
#
# 追加行はマージされた後にも直せるので、コミットは止めず、判定は報告を読んだ人間に任せる。
# マージされた後に直せないコミット本文は、.githooks/commit-msg が止める。
#
# 導入は .githooks/commit-msg と同じく git config core.hooksPath .githooks。

# set -e は使わない。
# 禁止語が見つかると lint が rc 1 を返し、-e があるとフックが 0 以外で終わってコミットが止まる。
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel)
LINT="$ROOT/scripts/lint-vocabulary.sh"

if [ ! -f "$LINT" ]; then
  echo "pre-commit: $LINT が無いので語彙の検査を飛ばした。" >&2
  exit 0
fi

report=$(bash "$LINT" --cached 2>/dev/null)
[ -z "$report" ] && exit 0

{
  echo "pre-commit: ステージした追加行に禁止語がある（コミットは続ける）:"
  printf '%s\n' "$report" | sed "s|^|  |"
  echo "  言い換え先は .claude/rules/writing.md「語彙と読み手」節の表。"
  echo "  この領域で比喩でない語なら .coding-standards-vocab-allow へ足す。"
} >&2
exit 0
